#version 430 core

layout(local_size_x = @workGroupSize, local_size_y = 1, local_size_z = 1) in;

#include "lib/light/bindings.glsl"

shared Cluster g_cluster;

shared uint g_Count;
shared uint g_Offset;
shared uint g_List[@maxLightsPerCluster];

#if @lightCap > 0
// OpenMGE XE [Shaders] max lights per cluster: a cluster reached by more lights keeps the strongest of them.
shared float g_Score[@maxLightsPerCluster];
shared uint g_Kept[@lightCap];
#endif

bool sphereAABBIntersection(vec3 center, float radius, vec3 aabbMin, vec3 aabbMax)
{
    vec3 closestPoint = clamp(center, aabbMin, aabbMax);
    return dot(closestPoint - center, closestPoint - center) <= radius * radius;
}

bool testSphereAABB(int i, Cluster cluster)
{
    vec3 center = pointLight[i].position.xyz;
    float radius = pointLight[i].radius;

    vec3 aabbMin = cluster.minPoint.xyz;
    vec3 aabbMax = cluster.maxPoint.xyz;

    return sphereAABBIntersection(center, radius, aabbMin, aabbMax);
}

#if @lightCap > 0
// About how much of a light reaches the nearest point of the cluster: its brightness times its distance curve and the
// fade to its radius (see calcAttenuation and calcPointLightBounce in lib/light/util.glsl), the bounce counted too as
// it reaches further than the direct light. Only the order matters. Carried lights always stay.
float lightScore(PointLight light, vec3 aabbMin, vec3 aabbMax)
{
    if (light.position.w >= 0.0)
        return 3.0e38;
    vec3 closestPoint = clamp(light.position.xyz, aabbMin, aabbMax);
    float d = length(closestPoint - light.position.xyz);
    float base = 1.0 / max(light.constant + light.linear * d + light.quadratic * d * d, 1.0e-4);
    float x = clamp((d / max(light.radius, 1.0e-4) - 0.75) / 0.25, 0.0, 1.0);
    float radiusFade = 1.0 - x * x * (3.0 - 2.0 * x);
    // negative lights darken: as strong the other way
    float brightness = abs(dot(light.diffuse.rgb, vec3(0.2126, 0.7152, 0.0722)))
        + abs(dot(light.ambient.rgb, vec3(0.2126, 0.7152, 0.0722)));
    return brightness * radiusFade * (min(base, 4.0) + 0.25 * sqrt(min(base, 1.0)));
}
#endif

void main()
{
    if (gl_LocalInvocationIndex == 0) {
        g_Count = 0;
        g_cluster = clusters[gl_WorkGroupID.x];
    }

    barrier();

    uint index = 0;

    for (uint i = gl_LocalInvocationIndex; i < pointLight.length(); i += @workGroupSize) {
        PointLight light = pointLight[i];

        vec3 center = light.position.xyz;
        float radius = light.radius;

        vec3 aabbMin = g_cluster.minPoint.xyz;
        vec3 aabbMax = g_cluster.maxPoint.xyz;

        if (sphereAABBIntersection(center, radius, aabbMin, aabbMax)) {
            index = atomicAdd(g_Count, 1);

            if (index >= @maxLightsPerCluster) break;

            g_List[index] = i;
#if @lightCap > 0
            g_Score[index] = lightScore(light, aabbMin, aabbMax);
#endif
        }
    }

    barrier();

    // more lights than the list holds: the others were left out above
    uint count = min(g_Count, uint(@maxLightsPerCluster));

#if @lightCap > 0
    // Too many: each light's place in order of strength (ties by index), the first lightCap kept.
    bool trim = count > uint(@lightCap);
    for (uint i = gl_LocalInvocationIndex; trim && i < count; i += @workGroupSize) {
        float score = g_Score[i];
        uint rank = 0;
        for (uint j = 0; j < count; ++j) {
            float other = g_Score[j];
            if (other > score || (other == score && j < i))
                ++rank;
        }
        if (rank < uint(@lightCap))
            g_Kept[rank] = g_List[i];
    }

    barrier();

    if (trim)
        count = uint(@lightCap);
#endif

    if (gl_LocalInvocationIndex == 0) {
        g_Offset = atomicAdd(globalLightIndexCount, count);
        lightGrid[gl_WorkGroupID.x] = LightGrid(g_Offset, count);
    }

    barrier();

    for (uint i = gl_LocalInvocationIndex; i < count; i += @workGroupSize) {
#if @lightCap > 0
        lightIndexList[g_Offset + i] = trim ? g_Kept[i] : g_List[i];
#else
        lightIndexList[g_Offset + i] = g_List[i];
#endif
    }
}
