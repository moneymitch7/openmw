                            <!-- OpenMGE XE: shadows at night -->
                            <Widget type="HBox" align="Stretch">
                                <UserString key="HStretch" value="true"/>
                                <UserString key="VStretch" value="false"/>
                                <Widget type="AutoSizedButton" skin="MW_Button">
